# Variáveis do Loop Principal
cycle_count=0       # Contador de ciclos (vai de 1 até 5)
explosion_active=0  # 0 = Desativada, 1 = Ativada
chars="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ#\$%&@*+"

# Loop principal da animação
while true; do
    get_terminal_size

    cx=$((COLS / 2))
    cy=$((LINES / 2))
    max_radius=$(( (COLS < LINES ? COLS : LINES) / 3 ))
    [ $max_radius -lt 4 ] && max_radius=6

    # Se a explosão estiver ativa, o raio expande o dobro
    if [ $explosion_active -eq 1 ]; then
        current_max=$((max_radius * 2))
    else
        current_max=$max_radius
    fi

    # Sequência de expansão e contração dos círculos (do pequeno ao grande e vice-versa)
    for r in $(seq 2 2 $current_max) $(seq $current_max -2 2); do
        screen_buffer=""
        current_color="${COLORS[$COLOR_IDX]}"

        screen_buffer+="$current_color"

        for ((y=0; y<LINES-2; y++)); do
            line_str=""
            for ((x=0; x<COLS; x++)); do
                dx=$((x - cx))
                dy=$((y - cy))
                dist_sq=$(( (dx * dx * 2) + (dy * dy * 4) ))
                r_sq=$((r * r * 8))

                diff=$((dist_sq - r_sq))
                [ $diff -lt 0 ] && diff=$((-diff))

                if [ $diff -lt $((r * 3)) ]; then
                    rand_char=${chars:RANDOM%${#chars}:1}
                    line_str+="$rand_char"
                elif [ $explosion_active -eq 1 ] && [ $((RANDOM % 8)) -eq 0 ]; then
                    line_str+="*" # Partículas de explosão
                else
                    line_str+=" " # Fundo limpo
                fi
            done
            screen_buffer+="$line_str\n"
        done

        # Desenha a tela atualizada sem piscar
        clear
        printf "%b" "$screen_buffer"

        # Barra de status informativa com o Contador de Ciclos (X/5)
        display_cycle=$((cycle_count + 1))
        if [ $explosion_active -eq 1 ]; then
            printf "\033[1;31m[!] EXPLOSÃO: ON [!] Ciclo: %d/5 | Cor: %s | [Toque] Desligar | [Ctrl+C] Sair\033[0m" "$display_cycle" "${COLOR_NAMES[$COLOR_IDX]}"
        else
            printf "\033[1;32m Ciclo: \033[1;33m%d/5\033[0m | \033[1;32mExplosão: \033[1;31mOFF\033[0m | \033[1;33m[Toque] Ligar/Cor | [Ctrl+C] Sair\033[0m" "$display_cycle"
        fi

        # Leitura rápida de toque/tecla (Alterna explosão ou muda cor)
        read -t 0.03 -n 1 input
        if [ $? -eq 0 ]; then
            if [ $explosion_active -eq 0 ]; then
                explosion_active=1
                printf "\a" # Som de ativação
            else
                COLOR_IDX=$(( (COLOR_IDX + 1) % ${#COLORS[@]} ))
            fi
        fi
    done

    # Incrementa contador de ciclos da bola
    cycle_count=$((cycle_count + 1))

    # A cada 5 ciclos completos, exibe o Cachorro Hacker Gigante por 30 segundos e reinicia a contagem
    if [ $cycle_count -ge 5 ]; then
        show_cyber_dog_alert
        cycle_count=0        # Reinicia a contagem após aparecer
        explosion_active=0   # Reseta a explosão para o novo ciclo
    fi
done
