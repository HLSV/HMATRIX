# Tratamento para restaurar o cursor e cores ao sair
trap 'printf "\033[?25h\033[0m\n"; exit 0' INT TERM EXIT

# Paleta de Cores ANSI Avançada
declare -a COLORS=("\033[32m" "\033[36m" "\033[33m" "\033[31m" "\033[35m" "\033[1;32m" "\033[1;36m")
declare -a COLOR_NAMES=("Verde Matrix" "Ciano Cyber" "Amarelo Neon" "Vermelho Alerta" "Magenta Deep" "Verde Brilhante" "Ciano Brilhante")
COLOR_IDX=0

# Função para detectar dimensões do terminal com segurança
get_terminal_size() {
    if command -v tput &>/dev/null; then
        COLS=$(tput cols 2>/dev/null)
        LINES=$(tput lines 2>/dev/null)
    fi
    : "${COLS:=80}"
    : "${LINES:=24}"
}

